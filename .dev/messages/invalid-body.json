{
  "id": "$MAIL_ID",
  "from": "$MAIL_FROM",
  "receiver": "$MAIL_TO",
  "subject": "Mailer App - failure test (invalid body)",
  "body": "not-valid-base64!!!",
  "callback": {
    "success": {
      "url": "$CALLBACK_SUCCESS_URL",
      "headers": {
        "Authorization": "Bearer test-token"
      }
    },
    "failure": {
      "url": "$CALLBACK_FAILURE_URL",
      "headers": {
        "Authorization": "Bearer test-token"
      }
    }
  }
}
