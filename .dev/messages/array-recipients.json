{
  "id": "$MAIL_ID",
  "from": "$MAIL_FROM",
  "receiver": [
    "$MAIL_TO"
  ],
  "cc": [
    "$MAIL_CC"
  ],
  "bcc": [
    "$MAIL_BCC"
  ],
  "subject": "Mailer App - teste com destinatários em array",
  "body": "",
  "attachments": [
    {
      "name": "teste.txt",
      "type": "text/plain",
      "data": "QW5leG8gZGUgdGVzdGUgZG8gbWFpbGVyLWFwcC4=",
      "decoder": "base64"
    }
  ],
  "callback": {
    "success": {
      "url": "$CALLBACK_SUCCESS_URL",
      "headers": {
        "Authorization": "Bearer token-de-teste"
      }
    },
    "failure": {
      "url": "$CALLBACK_FAILURE_URL",
      "headers": {
        "Authorization": "Bearer token-de-teste"
      }
    }
  }
}
