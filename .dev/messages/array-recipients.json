{
  "id": "$MAIL_ID",
  "from": "$MAIL_FROM",
  "receiver": [
    "$MAIL_TO"
  ],
  "cc": [
    "$MAIL_CC"
  ],
  "bcc": [
    "$MAIL_BCC"
  ],
  "subject": "Mailer App - array recipients test",
  "body": "",
  "attachments": [
    {
      "name": "test.txt",
      "type": "text/plain",
      "data": "bWFpbGVyLWFwcCB0ZXN0IGF0dGFjaG1lbnQu",
      "decoder": "base64"
    }
  ],
  "callback": {
    "success": {
      "url": "$CALLBACK_SUCCESS_URL",
      "headers": {
        "Authorization": "Bearer test-token"
      }
    },
    "failure": {
      "url": "$CALLBACK_FAILURE_URL",
      "headers": {
        "Authorization": "Bearer test-token"
      }
    }
  }
}
