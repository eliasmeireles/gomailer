# Real SMTP through Resend. Copy to smtp-resend.env and fill in.
MAILER_TRANSPORT=smtp
SMTP_SERVER=smtp.resend.com
SMTP_SERVER_PORT=465
SMTP_SERVER_USER=resend
SMTP_SERVER_PASS=re_xxxxxxxxx

# Without a verified domain Resend only accepts: make dev-publish FROM=onboarding@resend.dev TO=<account email>
