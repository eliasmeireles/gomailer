# Zoho Mail API (OAuth). Copy to zoho.env and fill in. See README "Zoho Mail" for the credentials.
MAILER_TRANSPORT=api
MAILER_API_CLIENT=zoho
ZOHO_MAIL_ACCOUNT_ID=0000000000000000000
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxx.xxxxxxxx
# ZOHO_MAIL_API_URL=https://mail.zoho.com
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# The message "from" must be an address/alias of this Zoho account.
